[Unit]
Description=LLaMA.cpp HTTP Server (Local HIP Optimized)
After=network.target

[Service]
Type=simple
ExecStart=/home/satori/.local/opt/llama.cpp/bin/llama-server \
  --agent \
  --models-dir /home/satori/Downloads/Models \
  --models-max 1 \
  -c 131072 \
  -ctk q8_0 \
  -ctv q8_0 \
  -ngl 99 \
  -b 1024 \
  -ub 256 \
  --flash-attn auto \
  --jinja \
  --parallel 1 \
  --port 11434 \
  --host localhost

Restart=on-failure
RestartSec=3s

# Security & Sandboxing
NoNewPrivileges=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/dri/* rw
DeviceAllow=/dev/kfd rw

# read-only /home
ProtectHome=read-only
ProtectSystem=strict
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
