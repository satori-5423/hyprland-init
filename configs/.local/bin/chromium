#!/usr/bin/env bash

# npx playwright install chromium

vp_w=1588
vp_h=800

if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    read -r mon_w mon_h mon_scale < <(hyprctl monitors -j 2>/dev/null |
        jq -r '.[0] | "\(.width) \(.height) \(.scale)"')
    if [ -n "${mon_w:-}" ] && [ -n "${mon_scale:-}" ]; then
        logical_w=$(awk -v w="$mon_w" -v s="$mon_scale" 'BEGIN{printf "%d", w/s}')
        logical_h=$(awk -v h="$mon_h" -v s="$mon_scale" 'BEGIN{printf "%d", h/s}')
        vp_w=$((logical_w - 2 * (5 + 1)))
        vp_h=$((logical_h - 2 * (5 + 1) - 88))
    fi
fi

exec npx playwright open --viewport-size="$vp_w,$vp_h" "$@"
